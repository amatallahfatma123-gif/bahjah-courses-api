{
  "info": {
    "name": "Bahjah Courses API",
    "description": "Postman collection for the Bahjah Courses API (Laravel 12 + Sanctum). Run Auth > Login first: it stores the token used by every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "course_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{$randomFullName}}\",\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Expected: 201. Stores the token in the `token` variable. Shares the 10 requests per minute limit with Login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (test user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Expected: 200. Stores the token in the `token` variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": "Expected: 200. Deletes the current token. Log in again afterwards."
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "List courses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/courses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "courses"
              ]
            },
            "description": "Expected: 200. Paginated, newest first, 5 per page."
          }
        },
        {
          "name": "List courses - page 2",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/courses?page=2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "courses"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "List courses - search",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/courses?search=Laravel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "courses"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Laravel"
                }
              ]
            }
          }
        },
        {
          "name": "List courses - published only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/courses?published=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "courses"
              ],
              "query": [
                {
                  "key": "published",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "List courses - published + search + per_page",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/courses?published=true&search=Laravel&per_page=3",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "courses"
              ],
              "query": [
                {
                  "key": "published",
                  "value": "true"
                },
                {
                  "key": "search",
                  "value": "Laravel"
                },
                {
                  "key": "per_page",
                  "value": "3"
                }
              ]
            }
          }
        },
        {
          "name": "Create course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/courses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "courses"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"REST APIs with Laravel\",\n  \"description\": \"Build and secure REST APIs.\",\n  \"price\": 49.5,\n  \"is_published\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Expected: 201. Stores the new id in `course_id`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('course_id', json.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Show course",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/courses/{{course_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "courses",
                "{{course_id}}"
              ]
            },
            "description": "Expected: 200 (404 if the course was deleted)."
          }
        },
        {
          "name": "Update course (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/courses/{{course_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "courses",
                "{{course_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"REST APIs with Laravel (updated)\",\n  \"price\": 59,\n  \"is_published\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Expected: 200."
          }
        },
        {
          "name": "Update course (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/courses/{{course_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "courses",
                "{{course_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_published\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Expected: 200. Only the sent field changes."
          }
        },
        {
          "name": "Delete course",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/courses/{{course_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "courses",
                "{{course_id}}"
              ]
            },
            "description": "Expected: 200."
          }
        },
        {
          "name": "Create course - validation error",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/courses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "courses"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Expected: 422 with errors.title."
          }
        },
        {
          "name": "List courses - no token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/courses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "courses"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Expected: 401 Unauthenticated."
          }
        }
      ]
    }
  ]
}
